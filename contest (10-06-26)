// Early Certificate

#include <iostream>
#include <string>
#include <algorithm> // For min function

using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, m;
        cin >> n >> m;
        string a, b;
        cin >> a >> b;
        string result = "";
        int limit = min(n, m);

        for (int i = 0; i < limit; i++) {
            if (a[i] == b[i]) {
                result += a[i];
            } else {
                break;
            }
        }
        cout << result << endl;
    }
    return 0;
}

