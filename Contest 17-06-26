// Loose Less :-

#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int m,n;
	    cin>>m>>n;
	    
	  if (n<= m)
            cout << m-n <<endl;
        else
            cout << (n-m) % 2 <<endl;
    }
   return 0;
}



// Interesting Match :-

#include <bits/stdc++.h>
using namespace std;

int main() {
int x,y;
cin>>x>>y;

int ans = x-y;
if(ans<0){
    ans = ans*-1;
}
if(ans<=2){
    cout<<"Interesting";
}else{
    cout<<"Boring";
}
return  0;

}
