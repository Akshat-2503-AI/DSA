// Previous Greater stack :=

#include <iostream>
#include <vector>
#include <stack>
using namespace std;

vector<int> previousGreater(vector<int>& arr) {
    stack<int> st;
    vector<int> ans;

    for (int i = 0; i < arr.size(); i++) {

        while (!st.empty() && st.top() <= arr[i]) {
            st.pop();
        }

        if (st.empty())
            ans.push_back(-1);
        else
            ans.push_back(st.top());

        st.push(arr[i]);
    }

    return ans;
}

int main() {
    vector<int> arr = {15, 10, 18, 12, 4, 6, 2, 8};

    vector<int> ans = previousGreater(arr);

    for (int x : ans)
        cout << x << " ";

    return 0;
}

// Previous Smaller stack :=

#include <iostream>
#include <vector>
#include <stack>
using namespace std;

vector<int> previousSmaller(vector<int>& arr) {
    stack<int> st;
    vector<int> ans;

    for (int i = 0; i < arr.size(); i++) {

        while (!st.empty() && st.top() >= arr[i]) {
            st.pop();
        }

        if (st.empty())
            ans.push_back(-1);
        else
            ans.push_back(st.top());

        st.push(arr[i]);
    }

    return ans;
}

int main() {
    vector<int> arr = {15, 10, 18, 12, 4, 6, 2, 8};

    vector<int> ans = previousSmaller(arr);

    for (int x : ans)
        cout << x << " ";

    return 0;
}
